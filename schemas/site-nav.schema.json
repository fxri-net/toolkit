{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fxri-net/toolkit/schemas/site-nav.schema.json",
  "title": "VitePress 文档站导航与侧栏",
  "description": "docs/site-nav.json 的结构定义：config.mts 引用该文件展开 nav 与 sidebar，toolkit docs nav check 按同一份定义校验结构。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nav": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/navItem" }
    },
    "sidebar": { "$ref": "#/$defs/sidebar" },
    "locales": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/localeEntry" }
    }
  },
  "oneOf": [{ "required": ["nav", "sidebar"] }, { "required": ["locales"] }],
  "$defs": {
    "sidebar": {
      "oneOf": [
        { "$ref": "#/$defs/sidebarList" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sidebarList" }
        }
      ]
    },
    "sidebarList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sidebarGroup" }
    },
    "localeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nav", "sidebar"],
      "properties": {
        "nav": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/navItem" }
        },
        "sidebar": { "$ref": "#/$defs/sidebar" }
      }
    },
    "navItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "link": { "type": "string", "minLength": 1 },
        "activeMatch": { "type": "string" },
        "rel": { "type": "string" },
        "target": { "type": "string" },
        "noIcon": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/navItem" }
        }
      },
      "oneOf": [{ "required": ["link"] }, { "required": ["items"] }]
    },
    "sidebarGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "items"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "collapsed": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sidebarItem" }
        }
      }
    },
    "sidebarItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "link": { "type": "string", "minLength": 1 },
        "collapsed": { "type": "boolean" },
        "base": { "type": "string" },
        "docFooterText": { "type": "string" },
        "rel": { "type": "string" },
        "target": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sidebarItem" }
        }
      }
    }
  }
}
